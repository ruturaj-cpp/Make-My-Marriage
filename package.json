{
  "name": "make-my-marriage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @mmm/web --filter @mmm/api --filter @mmm/worker dev",
    "dev:web": "pnpm --filter @mmm/web dev",
    "dev:api": "pnpm --filter @mmm/api dev",
    "dev:worker": "pnpm --filter @mmm/worker dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @mmm/shared-types build && pnpm --filter @mmm/validators build && pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @mmm/shared-types build && pnpm --filter @mmm/validators build && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
